  "redirects": [
    {
      "slug": "/step-by-step",
      "to": "/installation",
      "_why": [
        "JST-296 lifted docs/setup/STEP-BY-STEP.md out of Setup and split it into the",
        "Installation category, whose landing page inherited /installation. Docusaurus",
        "takes one slug per page, so /step-by-step — baked into jst-install's SKILL.md",
        "and plugins/jira-sdlc/README.md, and therefore into plugin caches that cannot",
        "be corrected retroactively — is served as a redirect instead of a page.",
        "website/docusaurus.config.js reads this list and hands it to",
        "@docusaurus/plugin-client-redirects, so the two cannot drift. Entries here are",
        "shipped URLs like any other slug: add, never remove."
      ]
    }
  ],
