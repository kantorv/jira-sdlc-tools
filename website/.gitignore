# Build products and caches only. Nothing here may grow to cover the versioning
# machinery: `docusaurus docs:version` writes versioned_docs/,
# versioned_sidebars/ and versions.json, and all three are committed on purpose —
# an ignored snapshot is a released version that silently is not on the site.
/node_modules
/build
/.docusaurus

.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.local
.env.development.local
.env.test.local
.env.production.local
