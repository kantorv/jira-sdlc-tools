# Machine-specific settings for the jira-sdlc skills. Copy this file to
# .jst/jira-sdlc-tools.local.env in your project root (the .jst/ folder is the
# only location the skills read) and gitignore that copy — it holds raw secrets.

# GITHUB SETTINGS (machine-specific)
WORKTREES_DIR=../myapp-worktrees
# Fine-grained GitHub PAT. Secret + machine-specific, so it lives ONLY here in
# the gitignored local.env (never the tracked .jst/jira-sdlc-tools.env), like the
# Jira role tokens. statuscheck logs gh out then back in with it at session start
# (gh auth logout; gh auth login --with-token) so a stale keyring token can't
# survive, and holds that session for the whole conversation; if it's missing
# the gh_auth row FAILs and the run halts. How to
# generate it (where to click, which repo scope + Contents/Pull-requests
# read/write permissions to grant) is in
# plugins/jira-sdlc/docs/github/GH-PAT-SESSION-LOGIN.md. Placeholder only — never
# commit a real token.
GITHUB_PAT_TOKEN="XXXXXXXXXXXXXXXXXX"

# JIRA SITE
JIRA_ACCOUNT_URL=your-site.atlassian.net

# PER-ROLE JIRA ACCOUNTS (all three REQUIRED) — each skill acts as its own Jira
# user, so the board shows who did what: the assigner filed it, the executor
# implemented it, the reviewer approved it. Every role needs BOTH its own email
# and its own token; there is no default account behind them, so a missing half
# stops the run instead of silently authenticating as somebody else. Pointing
# all three at one Atlassian account is fine — just fill in all six values.
#
# The executor's email doubles as the ASSIGNEE: jira-task-assigner puts it on
# every issue it creates, and jira-task-executor refuses to work an issue that
# isn't assigned to it.
#
# Tokens are the raw API token value, never a path to a file.
# Each call picks its credential via --role, so a token is used only on the
# request that names its role — see skills/_shared/project-config.md.
JIRA_ASSIGNER_EMAIL=assigner@example.com
JIRA_ASSIGNER_TOKEN=your-assigner-api-token-value
JIRA_EXECUTOR_EMAIL=executor@example.com
JIRA_EXECUTOR_TOKEN=your-executor-api-token-value
JIRA_REVIEWER_EMAIL=reviewer@example.com
JIRA_REVIEWER_TOKEN=your-reviewer-api-token-value


