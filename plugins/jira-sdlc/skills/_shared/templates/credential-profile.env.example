# A jira-sdlc credential profile: the credentials of every project on this
# machine whose GitHub owner is listed below, kept in ONE place outside every
# repo instead of a copy in each project's .jst/jira-sdlc-tools.local.env.
#
# Copy this file to ~/.config/jira-sdlc/profiles/<name>.env ($XDG_CONFIG_HOME
# honored; %APPDATA%\jira-sdlc\profiles\<name>.env on Windows), fill it in by
# hand, and make it yours alone:  chmod 600 ~/.config/jira-sdlc/profiles/<name>.env
# (a profile group or others can read is refused). <name>: letters, digits, . _ -
#
# A project uses it when its .jst/jira-sdlc-tools.env says JST_CREDENTIALS = <name>
# and its own local env sets none of the seven keys below; or, naming none, when
# ~/.config/jira-sdlc/default holds <name>. All seven are required — a profile
# is never mixed with a project's own keys. Rules:
# https://github.com/kantorv/jira-sdlc-tools/blob/main/plugins/jira-sdlc/skills/_shared/project-config.md (Credentials)
#
# Placeholders only — never commit a filled-in profile, and never paste one into
# a chat: it is nothing but secrets.

# The GitHub owners (users or orgs) this profile's PAT is for, space-separated.
# A project runs on the profile only when every owner of its remotes (the root's
# origin and each member's) is in this list.
PROFILE_GITHUB_OWNERS=your-org

# Fine-grained GitHub PAT (Contents + Pull requests read/write on the owners'
# repos; Actions read for the web app's CI checks). How to make one:
# https://kantorv.github.io/jira-sdlc-tools/docs/gh-pat-session-login
GITHUB_PAT_TOKEN=XXXXXXXXXXXXXXXXXX

# The three Jira role accounts — one email and one raw API token each. No site
# here: JIRA_ACCOUNT_URL is each project's own (.jst/jira-sdlc-tools.env), since
# one Atlassian account works on several sites.
JIRA_ASSIGNER_EMAIL=assigner@example.com
JIRA_ASSIGNER_TOKEN=your-assigner-api-token-value
JIRA_EXECUTOR_EMAIL=executor@example.com
JIRA_EXECUTOR_TOKEN=your-executor-api-token-value
JIRA_REVIEWER_EMAIL=reviewer@example.com
JIRA_REVIEWER_TOKEN=your-reviewer-api-token-value
